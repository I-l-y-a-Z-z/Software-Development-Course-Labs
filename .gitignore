# Build output and caches (at any lab depth)
out/
build/
target/
.gradle/
.kotlin/
*.class
*.log

# Share the course project configuration, not personal or generated IDE files.
**/.idea/**
!/.idea/
!/.idea/.gitignore
!/.idea/modules.xml
!/.idea/misc.xml
!/.idea/compiler.xml
!/.idea/encodings.xml
!/.idea/gradle.xml
!/.idea/vcs.xml
# Preserve the fork's existing shared settings when exporting its subtree.
!/Lab2-Java/arrays-cs-project/.idea/
!/Lab2-Java/arrays-cs-project/.idea/.gitignore
!/Lab2-Java/arrays-cs-project/.idea/gradle.xml
!/Lab2-Java/arrays-cs-project/.idea/misc.xml
!/Lab2-Java/arrays-cs-project/.idea/vcs.xml
*.iws

# Plain Java .iml files are intentionally tracked. Gradle generates its own.
/Lab2-Java/arrays-cs-project/**/*.iml

# Local migration backups and tool configuration
/.local-backups/
/.agents/
/.codex/
/.aws/

# Machine-specific files and local environment variables
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
